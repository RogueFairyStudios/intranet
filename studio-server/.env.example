# HTTP listen address (falls back to :$PORT or :8080)
STUDIO_ADDR=:8080

# PostgreSQL connection URL (shares roguefairy Postgres with Wiki.js; empty uses in-memory dev store)
STUDIO_DATABASE_URL=

# Base URL of Tellurian Authentik (accepts multi-app OIDC issuers under /application/o/<slug>/)
STUDIO_OIDC_BASE_URL=https://auth.telluriancorp.info

# Allowed Authentik OIDC application slugs and optional client_id -> tool mappings
STUDIO_OIDC_ALLOWED_SLUGS=aetherion,geppetto,rfs-intranet,rfs-lore-cli,rfs-lore-ci,goethe,animafaber,fontpit,carnifex,rfs-studio

# Optional explicit OIDC issuer URLs (comma-separated, for local/custom OIDC tests)
STUDIO_OIDC_ISSUERS=

# Shared internal secret used by Wiki.js (/p/studio) when delegating over studio.railway.internal
STUDIO_INTERNAL_KEY=

# Optional comma-separated bootstrap service keys (format: name:role:secret or raw stk_... admin keys)
STUDIO_SERVICE_KEYS=

# Optional Tellurian Authentik Core API token for live /api/v3/core/users/ and /api/v3/core/groups/ lookups
STUDIO_AUTHENTIK_API_URL=https://auth.telluriancorp.info
STUDIO_AUTHENTIK_API_TOKEN=

# Public Intranet base URL used to construct deep links (/p/studio?project=...)
STUDIO_INTRANET_URL=https://docs.roguefairy.net

# Max upload size in MiB for /v1/projects/{projectId}/files (default 50)
STUDIO_MAX_UPLOAD_MB=50

# Allowed browser CORS origins (comma-separated)
STUDIO_CORS_ORIGINS=https://docs.roguefairy.net,http://localhost:3000,http://localhost:5173
